# MicroDrama Studio Environment Configuration

# Database (Default: Local SQLite, Production: Supabase PostgreSQL)
DATABASE_URL=sqlite:///./storage/data/microdrama.db

# Storage (Default: Local filesystem storage under storage/media/)
STORAGE_ROOT=./storage/media

# LLM Providers (OpenAI, OpenRouter, Anthropic, Gemini, or Cloudflare AI)
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o

# Cloudflare Workers AI (Optional)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AUTH_TOKEN=

# Modal Deployment Configuration (Optional for Phase 0, required for Phase 4 & 5)
MODAL_APP_NAME=microdrama-studio-workers
MODAL_ENVIRONMENT=main

# Default Production Defaults
DEFAULT_FPS=24
DEFAULT_RESOLUTION=1080p
DEFAULT_ASPECT_RATIO=16:9
